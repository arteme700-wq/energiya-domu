<?xml version="1.0" encoding="utf-8"?>
<!-- Старі Android 7 можуть не мати коренів Let's Encrypt (ntfy.sh, GitHub), USERTrust (github.com)
     і DigiCert Global Root G2 / Global Root CA (ланцюг брокера EMQX Cloud). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="@raw/isrg_root_x1"/>
            <certificates src="@raw/isrg_root_x2"/>
            <certificates src="@raw/isrg_root_yr"/>
            <certificates src="@raw/isrg_root_ye"/>
            <certificates src="@raw/usertrust_ecc_certification_authority"/>
            <certificates src="@raw/usertrust_rsa_certification_authority"/>
            <certificates src="@raw/digicert_global_root_g2"/>
            <certificates src="@raw/digicert_global_root_ca"/>
        </trust-anchors>
    </base-config>
</network-security-config>
